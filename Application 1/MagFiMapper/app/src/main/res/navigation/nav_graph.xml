<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/setupFragment">

    <fragment
        android:id="@+id/setupFragment"
        android:name="com.magfi.mapper.ui.SetupFragment"
        android:label="Setup"
        tools:layout="@layout/fragment_setup">

        <action
            android:id="@+id/action_setupFragment_to_mappingFragment"
            app:destination="@id/mappingFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/mappingFragment"
        android:name="com.magfi.mapper.ui.MappingFragment"
        android:label="Mapping"
        tools:layout="@layout/fragment_mapping">

        <argument
            android:name="mapperName"
            app:argType="string" />
        <argument
            android:name="buildingName"
            app:argType="string" />
        <argument
            android:name="floorName"
            app:argType="string" />
        <argument
            android:name="startLandmark"
            app:argType="string" />
    </fragment>

</navigation>
