<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#0D2137"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Category icon -->
        <ImageView
            android:id="@+id/ivCategoryIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_science"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Room title -->
        <TextView
            android:id="@+id/tvDestinationName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="#E0F7FA"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ivCategoryIcon"
            app:layout_constraintEnd_toStartOf="@id/tvDestinationCategory"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvDestinationSubtitle" />

        <!-- Subtitle: Block C · Floor 3 -->
        <TextView
            android:id="@+id/tvDestinationSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="#546E7A"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/ivCategoryIcon"
            app:layout_constraintEnd_toStartOf="@id/tvDestinationCategory"
            app:layout_constraintTop_toBottomOf="@id/tvDestinationName"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Category badge -->
        <TextView
            android:id="@+id/tvDestinationCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#14FFEC"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_category_badge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
