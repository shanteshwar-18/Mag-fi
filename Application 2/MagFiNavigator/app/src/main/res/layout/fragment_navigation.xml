<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- ── LAYER 1: MAP CANVAS (fills entire screen) ────────────────── -->
    <com.magfi.navigator.core.MapCanvasView
        android:id="@+id/mapCanvasView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ── LAYER 2: TOP HUD OVERLAY ─────────────────────────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        app:cardBackgroundColor="#F20B132B"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeColor="#3314FFEC"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="48dp"
            android:paddingBottom="16dp">

            <!-- Row 1: HEADING | STEPS | ACCURACY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEADING"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp"
                        android:letterSpacing="0.08" />
                    <TextView
                        android:id="@+id/tvHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0°"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STEPS"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp"
                        android:letterSpacing="0.08" />
                    <TextView
                        android:id="@+id/tvSteps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACCURACY"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp"
                        android:letterSpacing="0.08" />
                    <TextView
                        android:id="@+id/tvAccuracy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FUSED"
                        android:textColor="@color/colorSecondary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: X | Y | FP COUNT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="X"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tvPosX"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00m"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="14sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Y"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tvPosY"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00m"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="14sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FP"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tvFp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 loaded"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="14sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── LAYER 3: LOW ACCURACY WARNING BADGE (center) ─────────────── -->
    <com.google.android.material.chip.Chip
        android:id="@+id/chipLowAccuracy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="150dp"
        android:text="@string/low_accuracy_warning"
        android:textColor="@color/colorError"
        android:visibility="gone"
        app:chipBackgroundColor="@color/colorErrorTrans20"
        app:chipStrokeColor="@color/colorError"
        app:chipStrokeWidth="1dp" />

    <!-- ── LAYER 4: BOTTOM DESTINATION PANEL ────────────────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDestination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="@color/colorSurface"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#3314FFEC"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Destination name row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvDestination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Select destination"
                    android:textColor="@color/colorSecondary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- ETA row -->
            <TextView
                android:id="@+id/tvEta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Route unavailable"
                android:textColor="@color/colorTextMuted"
                android:textSize="14sp" />

            <!-- Action buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReroute"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/re_route"
                    android:layout_marginEnd="8dp"
                    app:strokeColor="@color/colorSecondary"
                    android:textColor="@color/colorSecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClear"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/clear"
                    android:textColor="@color/colorTextMuted" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── RE-CENTER FAB ──────────────────────────────────────────────── -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabRecenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="16dp"
        android:layout_marginBottom="200dp"
        android:contentDescription="@string/re_center"
        app:backgroundTint="@color/colorSurface"
        app:srcCompat="@drawable/ic_my_location"
        app:tint="@color/colorSecondary" />

</FrameLayout>
